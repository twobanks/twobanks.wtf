# Variáveis de ambiente necessárias para executar o projeto.
# Copie este ficheiro para `.env.local` e preencha com valores reais.
# Não submeta valores sensíveis (tokens, chaves, senhas) ao repositório.

# ------------------------------------------------------------------
# OBRIGATÓRIAS (ausência ou valor inválido impede o build,
# exceto com SKIP_ENV_VALIDATION=1, ex.: CI)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/bancos"
RESEND_API_KEY="re_exemplo_0000000000000000"

# ------------------------------------------------------------------
# NextAuth (Auth.js v5)
# AUTH_SECRET é a variável canônica no v5. Gerar com: openssl rand -base64 32
# OBRIGATÓRIA em Produção. Cadastrar no painel da Vercel (Preview e Produção).
# NÃO commitar valores reais.
# ------------------------------------------------------------------
AUTH_SECRET="exemplo_gerar_com_openssl_rand_base64_32"
# NEXTAUTH_SECRET mantido como fallback de compatibilidade (opcional)
# NEXTAUTH_SECRET="exemplo_gerar_com_openssl_rand_base64_32"

# AUTH_TRUST_HOST=1 é necessário atrás do proxy da Vercel para confiar
# em X-Forwarded-Host nas URLs de callback.
AUTH_TRUST_HOST="1"

# ------------------------------------------------------------------
# OPCIONAIS (definir apenas quando o recurso for usado)
# ------------------------------------------------------------------
RESEND_FROM_EMAIL="noreply@twobanks.wtf"
COROS_AUTH_TOKEN=""
STRAVA_WEBHOOK_VERIFY_TOKEN=""
NEXT_PUBLIC_MAPBOX_TOKEN=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REFRESH_TOKEN=""

# ------------------------------------------------------------------
# Diferenças entre Preview (branch `banks`) e Produção
# ------------------------------------------------------------------
# As variáveis abaixo podem ter valores diferentes em cada ambiente.
# Cadastre cada uma separadamente nos painéis da Vercel:
#   → Projeto twobanks.wtf → Settings → Environment Variables
#   → Ambiente: Preview (branch banks) e Ambiente: Production
#
#   DATABASE_URL      → banco de staging/homologação (Preview) vs banco de produção
#   RESEND_API_KEY    → chave de ambiente de teste (Preview) vs chave de produção
#   RESEND_FROM_EMAIL → endereço de remetente usado em cada ambiente
#   AUTH_SECRET       → segredo distinto por ambiente (Preview ≠ Produção)
#   NEXT_PUBLIC_MAPBOX_TOKEN → token Mapbox por ambiente (opcional)
#   STRAVA_* / COROS_* / SPOTIFY_* → credenciais de integração por ambiente
#
# Regra: nunca commite valores reais. Use placeholders no .env.example
# e defina os valores reais apenas no painel da Vercel.